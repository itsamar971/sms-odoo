# Optional. Without SMTP settings, emails (reset links, invoices) are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Brightloop <billing@brightloop.com>"
APP_URL=http://localhost:3000
# Protects GET/POST /api/cron/billing (send as header x-cron-secret or ?secret=)
CRON_SECRET=dev-cron-secret
# Seed size (defaults 5000 / ~30000)
SEED_SUBSCRIPTIONS=5000
